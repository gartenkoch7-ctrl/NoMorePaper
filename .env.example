# Copy to .env (git-ignored) and replace the placeholders. Never commit .env.

# Password of the Postgres user "nomorepaper". Long and random, letters and digits only
# (it is embedded in a connection string, where ';' and '=' would break it).
POSTGRES_PASSWORD=ReplaceWithALongRandomPassword

# Host port of the web app. Always bound to 127.0.0.1; remote access via Tailscale (ADR-0002).
NOMOREPAPER_PORT=8080

# Optional OTLP collector inside your own network, e.g. http://otel-collector:4317.
# Empty means no telemetry export at all (AGENTS.md 2.4).
OTEL_EXPORTER_OTLP_ENDPOINT=

# Certificate that encrypts the Data Protection key ring (ADR-0015). Create it with
# scripts/new-keyring-certificate.ps1 (it prints both lines). Keep the file outside the repository and
# back it up apart from the data backups.
NOMOREPAPER_KEYRING_CERT=C:/Secrets/nomorepaper/keyring.pfx
NOMOREPAPER_KEYRING_CERT_PASSWORD=ReplaceWithThePasswordOfThePfx

# Host names the web app answers to, separated by semicolons. Add the Tailscale MagicDNS name
# (docs/kb/betrieb.md), e.g. localhost;127.0.0.1;nomorepaper.tailnet-name.ts.net
NOMOREPAPER_ALLOWED_HOSTS=localhost;127.0.0.1
