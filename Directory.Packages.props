<Project>
  <!-- Central package versions. New packages need a short justification in the PR (AGENTS.md 3). -->
  <ItemGroup>
    <!-- Microsoft.Extensions / EF Core / ASP.NET Core (.NET 10) -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />

    <!-- UI -->
    <PackageVersion Include="MudBlazor" Version="9.14.0" />

    <!-- Inputs (M4, ADR-0024): camera pages and mail texts as PDF; MIT. -->
    <PackageVersion Include="PDFsharp" Version="6.2.4" />
    <!-- PDFsharp 6.2.4 brings 8.0.1, which has known vulnerabilities (GHSA-846f-f764-76mx); lifted for every consumer. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <!-- Mail input (M4, ADR-0024): IMAP and MIME parsing; MIT. -->
    <PackageVersion Include="MailKit" Version="4.18.2" />

    <!-- Telemetry (AGENTS.md 2.3) -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />

    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.65.0" />
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.14.0" />
  </ItemGroup>
</Project>
