@* The form for the fields of one document, used in the viewer and in "Zu prüfen". It is a group and
   not a <form>: the comboboxes use Enter to pick, which must never submit. Saving counts as
   confirming. Problems are announced and focus goes to the field that has to change. *@
<div class="fields-editor" role="group" aria-labelledby="@Prefix-heading">
    <MudText Typo="Typo.h3" id="@(Prefix + "-heading")">@L["ClsEditHeading"]</MudText>
    @if (_loadError is not null)
    {
        <NoticeBox Kind="NoticeKind.Error" Announce="true" Message="@L["ClsEditLoadError", _loadError]" />
        <div class="button-row">
            <button type="button" class="nmp-button" @onclick="LoadAsync">@L["Retry"]</button>
            <button type="button" class="nmp-button" @onclick="() => OnCancel.InvokeAsync()">@L["Cancel"]</button>
        </div>
    }
    else if (_loading)
    {
        <p role="status">@L["ClsEditLoading"]</p>
    }
    else
    {
        <p class="form-hint">@L["ClsEditHint"]</p>
        <div class="form-field">
            <label for="@Prefix-title">@L["ClsFieldTitle"]</label>
            <input id="@Prefix-title" class="form-input" type="text" maxlength="200" @bind="_title" @bind:event="oninput" />
        </div>
        <EntryCombobox Id="@(Prefix + "-correspondent")" Label="@L["ClsFieldCorrespondent"]" Hint="@L["ClsComboHint"]"
                       Entries="_correspondents" @bind-Value="_correspondent" OnCreate="CreateFor(EntryKind.Correspondents, _correspondents)" />
        <EntryCombobox Id="@(Prefix + "-type")" Label="@L["ClsFieldType"]" Hint="@L["ClsComboHint"]"
                       Entries="_types" @bind-Value="_type" OnCreate="CreateFor(EntryKind.DocumentTypes, _types)" />
        <div class="form-field">
            <label for="@Prefix-date">@L["ClsFieldDate"]</label>
            <input id="@Prefix-date" class="form-input" type="date" @bind="_date" aria-describedby="@Prefix-date-hint" />
            <p id="@Prefix-date-hint" class="form-hint">@L["ClsFieldDateHint"]</p>
        </div>
        <div class="form-field">
            <label for="@Prefix-amount">@L["ClsFieldAmount"]</label>
            <input id="@Prefix-amount" class="form-input" type="text" inputmode="decimal" autocomplete="off"
                   @bind="_amountText" @bind:event="oninput" aria-invalid="@(_form.IsInvalid(Prefix + "-amount") ? "true" : null)"
                   aria-describedby="@Prefix-amount-hint" />
            <p id="@Prefix-amount-hint" class="form-hint">@L["ClsFieldAmountHint"]</p>
        </div>
        <div class="form-field">
            <label for="@Prefix-currency">@L["ClsFieldCurrency"]</label>
            <input id="@Prefix-currency" class="form-input form-input-short" type="text" maxlength="3" autocomplete="off"
                   autocapitalize="characters" @bind="_currency" @bind:event="oninput"
                   aria-invalid="@(_form.IsInvalid(Prefix + "-currency") ? "true" : null)" />
        </div>
        <div class="form-field">
            <label for="@Prefix-summary">@L["ClsFieldSummary"]</label>
            <textarea id="@Prefix-summary" class="form-input" rows="4" @bind="_summary" @bind:event="oninput"></textarea>
        </div>
        <TagPicker Id="@(Prefix + "-tags")" Label="@L["ClsFieldTags"]" Tags="_tags" TagsChanged="TagsChangedAsync"
                   AllTags="_allTags" OnCreate="CreateFor(EntryKind.Tags, _allTags)" />
        <LiveRegion @ref="_error" Assertive="true" Class="form-error" />
        <div class="button-row">
            <button type="button" class="nmp-button" disabled="@_busy" @onclick="SaveAsync">@L["ClsSave"]</button>
            <button type="button" class="nmp-button" @onclick="() => OnCancel.InvokeAsync()">@L["Cancel"]</button>
        </div>
    }
</div>

