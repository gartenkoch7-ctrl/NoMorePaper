@* One maintained list (correspondents, document types or tags) on the page "Listen": rename an
   entry, or select several and merge them. Both ask in a group on the page, not in a modal dialog:
   the safe choice comes first and takes focus, and Escape cancels. *@
<section class="list-section" aria-labelledby="@Prefix-heading">
    <MudText Typo="Typo.h2" id="@(Prefix + "-heading")">@Heading</MudText>
    <LiveRegion @ref="_status" />
    <LiveRegion @ref="_error" Assertive="true" Class="form-error" />

    @if (_loading)
    {
        <p role="status">@L["ListsLoading"]</p>
    }
    else if (_loadError is not null)
    {
        <div role="alert" class="error-box" data-ready>
            <MudIcon Icon="@Icons.Material.Filled.Error" />
            <span>@L["ListsLoadError", _loadError]</span>
        </div>
        <button type="button" class="nmp-button" @onclick="LoadAsync">@L["Retry"]</button>
    }
    else if (_entries.Length == 0)
    {
        <p data-ready>@L["ListsEmpty"]</p>
    }
    else
    {
        <table class="doc-table" data-ready>
            <caption>@L["ListsCaption", Heading]</caption>
            <thead>
                <tr>
                    <th scope="col">@L["ColName"]</th>
                    <th scope="col">@L["ListsColMerge"]</th>
                    <th scope="col">@L["ColActions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in _entries)
                {
                    <tr @key="entry.Id">
                        <th scope="row">@entry.Name</th>
                        <td>
                            <input type="checkbox" id="@RowId("select", entry)" class="list-select" aria-label="@L["ListsSelectFor", entry.Name]"
                                   checked="@_selected.Contains(entry.Id)" @onchange="args => Toggle(entry.Id, args.Value is true)" />
                        </td>
                        <td>
                            <button type="button" id="@RowId("rename", entry)" class="nmp-button" aria-label="@L["ListsRenameFor", entry.Name]"
                                    @onclick="() => AskRename(entry)">@L["ListsRename"]</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="list-selected">@L["ListsSelectedCount", _selected.Count]</p>
        <button type="button" id="@(Prefix)-merge" class="nmp-button" @onclick="AskMerge">@L["ListsMerge"]</button>
    }

    @if (_renaming is not null)
    {
        <section class="confirm-box" role="group" aria-labelledby="@Prefix-rename-heading" @onkeydown="OnRenameKey">
            <MudText Typo="Typo.h3" id="@(Prefix + "-rename-heading")">@L["ListsRenameHeading", _renaming.Name]</MudText>
            <div class="form-field">
                <label for="@Prefix-rename-input">@L["ListsNewName"]</label>
                <input id="@Prefix-rename-input" class="form-input" type="text" maxlength="200" autocomplete="off"
                       @bind="_newName" @bind:event="oninput" />
            </div>
            <div class="button-row">
                <button type="button" class="nmp-button" @onclick="CancelRename">@L["Cancel"]</button>
                <button type="button" class="nmp-button" @onclick="RenameAsync">@L["ListsRenameConfirm"]</button>
            </div>
        </section>
    }

    @if (_merging)
    {
        <section class="confirm-box" role="group" aria-labelledby="@Prefix-merge-heading" @onkeydown="OnMergeKey">
            <MudText Typo="Typo.h3" id="@(Prefix + "-merge-heading")">@L["ListsMergeQuestion", _selected.Count]</MudText>
            <p>@L["ListsMergeExplain"]</p>
            <div class="form-field">
                <label for="@Prefix-merge-target">@L["ListsMergeTarget"]</label>
                <select id="@Prefix-merge-target" class="form-input" @bind="_target">
                    @foreach (var entry in _entries.Where(entry => _selected.Contains(entry.Id)))
                    {
                        <option value="@entry.Id">@entry.Name</option>
                    }
                </select>
            </div>
            <div class="button-row">
                <button type="button" id="@(Prefix)-merge-cancel" class="nmp-button" @onclick="CancelMerge">@L["Cancel"]</button>
                <button type="button" class="nmp-button" @onclick="MergeAsync">@L["ListsMergeConfirm"]</button>
            </div>
        </section>
    }
</section>
