@* "Angaben" of a document in the viewer: the read-only summary (DocumentFieldsSummary), then the owner check,
   the editor or its buttons, and for the owner the switch "Privat" and the choice of editors. The heading is
   only for screen readers (the tab already shows the word), so jumping by headings still works. *@
<section class="fields-panel" aria-labelledby="fields-heading">
    <MudText Typo="Typo.h2" id="fields-heading" Class="nmp-visually-hidden">@L["ClsFieldsHeading"]</MudText>
    <LiveRegion @ref="_status" />
    @if (_loadError is not null)
    {
        <NoticeBox Kind="NoticeKind.Error" Announce="true" Message="@L["ClsFieldsLoadError", _loadError]" />
        <button type="button" id="fields-retry" class="nmp-button" @onclick="LoadAsync">@L["Retry"]</button>
    }
    else if (_handedOver is not null)
    {
        @* The document is no longer ours to see: say where it went, and offer the way back. *@
        <p id="fields-handed" tabindex="-1">@_handedOver <a href="dokumente">@L["InpOwnerCheckToDocuments"]</a></p>
    }
    else if (_fields is null)
    {
        <p role="status">@L["ClsFieldsLoading"]</p>
    }
    else
    {
        <DocumentFieldsSummary Fields="_fields" />

        <OwnerCheckSection DocumentId="DocumentId" Title="@Title" Prefix="fields-owner" NeedsCheck="_fields.NeedsOwnerCheck" OnAnswered="OwnerAnsweredAsync" />

        @if (_editing)
        {
            <DocumentFieldsEditor DocumentId="DocumentId" DocumentTitle="@Title" Fields="_fields"
                                  OnSaved="SavedAsync" OnCancel="CancelEdit" OnConflict="ChangedMeanwhileAsync" />
        }
        else if (_fields.CanEdit)
        {
            <div class="button-row">
                <button type="button" id="fields-edit" class="nmp-button" @onclick="StartEdit">@L["ClsEdit"]</button>
                @if (_fields.Recognition == DocumentRecognitionState.Automatic)
                {
                    <button type="button" id="fields-confirm" class="nmp-button" disabled="@_busy" @onclick="ConfirmAsync">@L["ClsConfirm"]</button>
                }
            </div>
        }
    }

    @* Only the owner can change it; it also shows when the fields do not load. *@
    @if (IsMine && _handedOver is null)
    {
        <DocumentPrivacy DocumentId="DocumentId" IsPrivate="IsPrivate" OnChanged="PrivacyChangedAsync" />
    }

    @if (IsMine && _fields is not null && _handedOver is null && _loadError is null)
    {
        <EditorsPicker DocumentId="DocumentId" SelectedIds="_fields.EditorIds" OnSaved="EditorsSavedAsync" />
    }
</section>
