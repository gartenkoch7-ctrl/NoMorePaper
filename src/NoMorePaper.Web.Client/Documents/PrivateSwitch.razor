@using NoMorePaper.Web.Client.Inputs
@inject IStringLocalizer<Strings> L
@inject PreferencesApi Preferences
@inject IJSRuntime Js

@* The "private" switch of the upload and camera pages, preset from the account. It sends a choice only when
   the person changed it; otherwise the server applies the account's setting. Should that setting not load,
   the switch never claims "shared": it is in its third state ("mixed") and the hint says the account decides.
   data-ready marks that the account's setting was asked (loaded or failed), so tests do not race it. *@
<div class="form-check">
    <input id="@Id" type="checkbox" checked="@(Effective ?? false)" aria-describedby="@(Id + "-hint")" data-ready="@(_loaded ? "true" : null)"
           @onchange="args => _choice = args.Value is true" />
    <label for="@Id">@L["PrivateLabel"]</label>
</div>
<p id="@(Id + "-hint")" class="form-hint">@(IsUnknown ? L["PrivateUnknown"].Value : Hint)</p>

@code {
    // The account's setting; null until it is loaded, and when it could not be.
    private bool? _preference;
    private bool? _choice;
    private bool _loaded;
    private bool _indeterminate;

    /// <summary>Id of the checkbox; its hint gets the id with <c>-hint</c>.</summary>
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;

    /// <summary>What "private" means on this page, while the account's setting is known.</summary>
    [Parameter, EditorRequired] public string Hint { get; set; } = string.Empty;

    /// <summary>What the page sends: the person's own choice, or <c>null</c> so the server takes the account's setting.</summary>
    public bool? Choice => _choice;

    /// <summary>What the document becomes: the choice, else the account's setting; <c>null</c> when neither is known.</summary>
    public bool? Effective => _choice ?? _preference;

    private bool IsUnknown => _loaded && Effective is null;

    protected override async Task OnInitializedAsync()
    {
        var result = await Preferences.GetAsync();
        (_preference, _loaded) = (result.Value?.NewDocumentsPrivate, true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_indeterminate != IsUnknown)
        {
            _indeterminate = IsUnknown;
            await Js.InvokeVoidAsync("nmpForms.setIndeterminate", Id, _indeterminate);
        }
    }
}
