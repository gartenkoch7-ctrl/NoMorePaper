@inject IStringLocalizer<Strings> L

@* State as symbol and word, never colour alone. The symbol is decoration, the word carries the meaning. *@
<span class="nmp-status">
    <MudIcon Icon="@Icon" aria-hidden="true" />
    <span>@L[Key]</span>
</span>

@code {
    [Parameter, EditorRequired] public StatusKind Kind { get; set; }

    private string Key => Kind switch
    {
        StatusKind.Waiting => "StatusWaiting",
        StatusKind.Processing => "StatusProcessing",
        StatusKind.Done => "StatusDone",
        StatusKind.Failed => "StatusFailed",
        _ => "StatusRecognized",
    };

    private string Icon => Kind switch
    {
        StatusKind.Waiting => Icons.Material.Filled.Schedule,
        StatusKind.Processing => Icons.Material.Filled.Sync,
        StatusKind.Done => Icons.Material.Filled.CheckCircle,
        StatusKind.Failed => Icons.Material.Filled.Error,
        _ => Icons.Material.Filled.AutoAwesome,
    };
}
