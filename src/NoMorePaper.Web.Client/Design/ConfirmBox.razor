@inject IStringLocalizer<Strings> L
@inject IJSRuntime Js

@* Confirmation inside the page (no modal dialog), exposed as a labelled group. Focus moves to the
   heading when it opens so the screen reader reads the question (or to InitialFocusId when the
   caller names a better target); "Cancel" comes first so the safe choice is reached first, and
   Escape cancels. The heading level fits the page outline (axe heading-order): 2 below the H1,
   3 inside a section. *@
<div class="nmp-confirm" role="group" aria-labelledby="@(Id)-heading" @onkeydown="OnKeyDownAsync">
    @switch (HeadingLevel)
    {
        case 3:
            <h3 @ref="_heading" id="@(Id)-heading" tabindex="-1">@Title</h3>
            break;
        case 4:
            <h4 @ref="_heading" id="@(Id)-heading" tabindex="-1">@Title</h4>
            break;
        default:
            <h2 @ref="_heading" id="@(Id)-heading" tabindex="-1">@Title</h2>
            break;
    }
    @if (!string.IsNullOrEmpty(Text))
    {
        <p>@Text</p>
    }
    @ChildContent
    <div class="nmp-confirm-actions">
        <button type="button" class="nmp-button nmp-button-outlined" @onclick="OnCancel">@L["Cancel"]</button>
        <button type="button" class="@(PrimaryConfirm ? "nmp-button nmp-button-primary" : "nmp-button")" @onclick="OnConfirm">@ConfirmLabel</button>
    </div>
</div>

@code {
    private ElementReference _heading;

    /// <summary>Unique id on the page; the heading gets "{Id}-heading" as the group's label.</summary>
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Heading level of the question: 2 (default), 3 or 4.</summary>
    [Parameter] public int HeadingLevel { get; set; } = 2;

    [Parameter] public string? Text { get; set; }

    /// <summary>Extra content between the text and the buttons (for example a form field).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter, EditorRequired] public string ConfirmLabel { get; set; } = string.Empty;

    /// <summary>Render the confirm button as the white main action; default is neutral (outlined).</summary>
    [Parameter] public bool PrimaryConfirm { get; set; }

    /// <summary>Element id that gets the focus instead of the heading when the box opens.</summary>
    [Parameter] public string? InitialFocusId { get; set; }

    [Parameter] public EventCallback OnConfirm { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (!string.IsNullOrEmpty(InitialFocusId))
        {
            await Js.InvokeVoidAsync("nmpForms.focusById", InitialFocusId);
        }
        else
        {
            await _heading.FocusAsync();
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnCancel.InvokeAsync();
        }
    }
}
