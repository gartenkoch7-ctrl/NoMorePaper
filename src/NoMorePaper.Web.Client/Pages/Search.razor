@page "/suche"
@using System.Globalization
@implements IDisposable
@inject IStringLocalizer<Strings> L
@inject DocumentApi Api
@inject ILogger<Search> Logger

<PageTitle>@L["SearchTitle"]</PageTitle>

<MudText Typo="Typo.h1">@L["SearchHeading"]</MudText>

@* The search field lives in the page header (HeaderSearch), so it is the same on every page and
   the "/" shortcut always finds it. This page shows what came back. *@
<LiveRegion @ref="_summary" />

@if (_error is not null)
{
    <div role="alert" class="error-box" data-ready>
        <MudIcon Icon="@Icons.Material.Filled.Error" />
        <span>@L["SearchError", _error]</span>
    </div>
}
else if (string.IsNullOrWhiteSpace(Query))
{
    <p data-ready>@L["SearchPrompt"]</p>
}
else if (_hits is not null)
{
    <div data-ready>
        @* Visible as well as announced: without it a search with no hits leaves the page empty. *@
        <p class="search-summary">@CountText(_hits.Length, _searched ?? string.Empty)</p>
        @foreach (var hit in _hits)
        {
            <article class="search-hit" @key="hit.Id">
                <MudText Typo="Typo.h2"><a href="@DocumentLinks.Viewer(hit.Id)">@hit.Title</a></MudText>
                @* Hits come from the OCR text, so the document is done and has its PDF/A. *@
                <Thumbnail Source="@DocumentLinks.Archive(hit.Id)" Title="@hit.Title" />
                @* The snippet is plain text from the server and is rendered as text, never as HTML. *@
                <p>@hit.Snippet</p>
                <p class="search-hit-date">@L["SearchReceived", hit.ReceivedAt.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)]</p>
            </article>
        }
    </div>
}

@code {
    private CancellationTokenSource? _cts;
    private LiveRegion? _summary;
    private SearchHitDto[]? _hits;
    private string? _error;
    private string? _searched;

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var query = Query?.Trim();
        if (query == _searched)
        {
            return;
        }

        _searched = query;
        _cts?.Cancel();
        _hits = null;
        _error = null;
        if (string.IsNullOrEmpty(query))
        {
            _summary?.Clear();
            return;
        }

        _cts = new CancellationTokenSource();
        await SearchAsync(query, _cts.Token);
    }

    private async Task SearchAsync(string query, CancellationToken ct)
    {
        await AnnounceAsync(L["SearchRunning", query]);
        var result = await Api.SearchAsync(query, ct: ct);
        if (ct.IsCancellationRequested)
        {
            return;
        }

        if (!result.IsSuccess)
        {
            _error = result.Error;
            _summary?.Clear();
            return;
        }

        _hits = result.Value ?? [];
        Logger.SearchCompleted(_hits.Length);
        await AnnounceAsync(CountText(_hits.Length, query));
    }

    private string CountText(int count, string query) =>
        count == 1 ? L["SearchCountOne", query] : L["SearchCount", count, query];

    private async Task AnnounceAsync(string message)
    {
        if (_summary is not null)
        {
            await _summary.Announce(message);
        }
    }

    public void Dispose() => _cts?.Cancel();
}
