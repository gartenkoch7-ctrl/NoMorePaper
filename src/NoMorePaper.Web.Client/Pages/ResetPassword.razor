@page "/passwort/{Token}"
@inject IStringLocalizer<Strings> L
@inject AccountApi Api
@inject IJSRuntime Js
@inject ILogger<ResetPassword> Logger

<PageTitle>@L["ResetTitle"]</PageTitle>

<AccountFrame Heading="@L["ResetHeading"]" Intro="@(_done ? null : L["ResetIntro"].Value)">
    @if (_done)
    {
        @* The result replaces the form: it is a status text with a link on, not an easily missed toast. *@
        <div role="status" data-ready tabindex="-1" @ref="_result">
            <NoticeBox Kind="NoticeKind.Success" Message="@L["ResetDone"]" />
        </div>
        <p><a href="anmelden">@L["SetupToSignIn"]</a></p>
    }
    else
    {
        <form class="account-form" novalidate @onsubmit="SubmitAsync" data-ready>
            <FormField Id="reset-password" Label="@L["FieldNewPassword"]" Autocomplete="new-password" Password="true"
                       Icon="@Icons.Material.Outlined.Lock"
                       Hint="@L["HintPasswordLength", FormValidation.MinPasswordLength]"
                       @bind-Value="_password" Invalid='_form.IsInvalid("reset-password")' />
            <FormField Id="reset-repeat" Label="@L["FieldRepeatPassword"]" Autocomplete="new-password" Password="true"
                       Icon="@Icons.Material.Outlined.Lock"
                       @bind-Value="_repeat" Invalid='_form.IsInvalid("reset-repeat")' />
            <LiveRegion @ref="_error" Assertive="true" Class="form-error" />
            <button type="submit" class="nmp-button nmp-button-primary account-frame-submit" disabled="@_busy">
                <span>@L["ResetButton"]</span><MudIcon Icon="@Icons.Material.Filled.ArrowForward" aria-hidden="true" />
            </button>
        </form>
    }
</AccountFrame>

@code {
    private FormValidation _form = default!;
    private LiveRegion? _error;
    private ElementReference _result;
    private string _password = string.Empty;
    private string _repeat = string.Empty;
    private bool _done;
    private bool _busy;
    private bool _focusResult;

    [Parameter] public string Token { get; set; } = string.Empty;

    protected override void OnInitialized() => _form = new FormValidation(L, Js);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusResult)
        {
            _focusResult = false;
            await _result.FocusAsync();
        }
    }

    private async Task SubmitAsync()
    {
        _form.Reset();
        _form.NewPassword("reset-password", _password, "reset-repeat", _repeat, L["FieldNewPassword"]);
        if (await _form.ReportAsync(_error))
        {
            return;
        }

        _busy = true;
        var result = await Api.ResetPasswordAsync(Token, new(_password));
        _busy = false;
        if (!result.IsSuccess)
        {
            _form.Refused(result, "reset-password");
            await _form.ReportAsync(_error);
            return;
        }

        Logger.PasswordChanged("reset-link");
        _password = _repeat = string.Empty;
        _done = true;
        _focusResult = true;
    }
}
