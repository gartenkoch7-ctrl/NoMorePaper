@page "/mitglieder"
@using System.Globalization
@inject IStringLocalizer<Strings> L
@inject AccountApi Api
@inject AuthState Auth
@inject NavigationManager Navigation
@inject ILogger<Members> Logger

<PageTitle>@L["MembersTitle"]</PageTitle>

<Breadcrumb Items="_path" />

<MudText Typo="Typo.h2" HtmlTag="h1">@L["MembersHeading"]</MudText>

@if (!Auth.IsAdmin)
{
    <p data-ready>@L["MembersAdminOnly"]</p>
}
else
{
    <LiveRegion @ref="_status" />
    <LiveRegion @ref="_error" Assertive="true" Class="form-error" />

    <section class="members-invite" aria-labelledby="invite-heading">
        <div class="members-invite-head">
            <div>
                <MudText Typo="Typo.h3" HtmlTag="h2" id="invite-heading">@L["MembersInviteHeading"]</MudText>
                <p>@L["MembersInviteExplain"]</p>
            </div>
            <button type="button" class="nmp-button nmp-button-primary" @ref="_inviteButton" @onclick="InviteAsync">@L["MembersInviteButton"]</button>
        </div>
        @if (_invitation is not null)
        {
            <div class="members-link">
                <CopyField @ref="_inviteLink" Id="invite-link" Label="@L["MembersInviteLinkLabel"]" Value="@Absolute(_invitation.Link)" />
                <p>@L["MembersLinkValid", Expires(_invitation)]</p>
            </div>
        }
    </section>

    <section class="members-list" aria-labelledby="members-heading">
        <MudText Typo="Typo.h3" HtmlTag="h2" id="members-heading">@L["MembersListHeading"]</MudText>
        @if (_loading)
        {
            <p role="status">@L["MembersLoading"]</p>
        }
        else if (_loadError is not null)
        {
            <div data-ready><NoticeBox Kind="NoticeKind.Error" Announce="true" Message="@L["MembersLoadError", _loadError]" /></div>
        }
        else
        {
            <div class="table-scroll" role="region" aria-labelledby="members-caption" tabindex="0">
            <table class="doc-table" data-ready>
                <caption id="members-caption">@L["MembersCaption"]</caption>
                <thead>
                    <tr>
                        <th scope="col">@L["ColName"]</th>
                        <th scope="col">@L["FieldUserName"]</th>
                        <th scope="col">@L["ColRole"]</th>
                        <th scope="col">@L["ColActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in _members)
                    {
                        <tr @key="member.Id">
                            <th scope="row">@member.DisplayName</th>
                            <td>@member.UserName</td>
                            <td>
                                <Badge Icon="@(member.IsAdmin ? Icons.Material.Filled.AdminPanelSettings : Icons.Material.Filled.Person)"
                                       Text="@(member.IsAdmin ? L["RoleAdmin"] : L["RoleMember"])" />
                            </td>
                            <td>
                                @if (!member.IsAdmin)
                                {
                                    <button type="button" class="nmp-button" aria-label="@L["MembersResetFor", member.DisplayName]"
                                            @onclick="() => ResetLinkAsync(member)">@L["MembersResetButton"]</button>
                                    <button type="button" class="nmp-button" aria-label="@L["MembersRemoveFor", member.DisplayName]"
                                            @onclick="() => AskRemove(member)">@L["MembersRemoveButton"]</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </section>

    @if (_resetFor is not null && _resetLink is not null)
    {
        <section class="members-link" aria-labelledby="reset-heading">
            <MudText Typo="Typo.h3" HtmlTag="h2" id="reset-heading">@L["MembersResetHeading", _resetFor.DisplayName]</MudText>
            <CopyField @ref="_resetField" Id="reset-link" Label="@L["MembersResetLinkLabel"]" Value="@Absolute(_resetLink.Link)" />
            <p>@L["MembersLinkValid", Expires(_resetLink)]</p>
        </section>
    }

    @if (_removing is not null)
    {
        <ConfirmBox @key="_removing.Id" Id="members-remove" Title="@L["MembersRemoveQuestion", _removing.DisplayName]" Text="@L["MembersRemoveExplain"]"
                    ConfirmLabel="@L["MembersRemoveConfirm"]" OnConfirm="RemoveAsync" OnCancel="CancelRemove" />
    }
}
