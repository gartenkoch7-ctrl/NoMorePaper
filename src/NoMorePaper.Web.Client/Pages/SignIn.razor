@page "/anmelden"
@inject IStringLocalizer<Strings> L
@inject AccountApi Api
@inject AuthState Auth
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject ILogger<SignIn> Logger

<PageTitle>@L["SignInTitle"]</PageTitle>

<AccountFrame Heading="@L["SignInHeading"]" Intro="@L["SignInIntro"]">
    <form class="account-form" novalidate @onsubmit="SubmitAsync" data-ready>
        <FormField Id="signin-user" Label="@L["FieldUserName"]" Autocomplete="username" Icon="@Icons.Material.Outlined.Person"
                   @bind-Value="_userName" Invalid='_form.IsInvalid("signin-user")' />
        <FormField Id="signin-password" Label="@L["FieldPassword"]" Autocomplete="current-password" Password="true"
                   Icon="@Icons.Material.Outlined.Lock"
                   @bind-Value="_password" Invalid='_form.IsInvalid("signin-password")' />
        <p class="account-frame-help">@L["SignInForgotShort"]</p>
        <LiveRegion @ref="_error" Assertive="true" Class="form-error" />
        <button type="submit" class="nmp-button nmp-button-primary account-frame-submit" disabled="@_busy">
            <span>@L["SignInButton"]</span><MudIcon Icon="@Icons.Material.Filled.ArrowForward" aria-hidden="true" />
        </button>
    </form>
    <a class="account-frame-secondary" href="notfall">
        <MudIcon Icon="@Icons.Material.Outlined.Key" aria-hidden="true" /><span>@L["SignInEmergencyLink"]</span>
    </a>
</AccountFrame>

@code {
    private FormValidation _form = default!;
    private LiveRegion? _error;
    private string _userName = string.Empty;
    private string _password = string.Empty;
    private bool _busy;

    // Where to go after signing in: only a path inside this app, never another site.
    [SupplyParameterFromQuery(Name = "ziel")]
    public string? Target { get; set; }

    protected override void OnInitialized()
    {
        _form = new FormValidation(L, Js);

        // Someone who is signed in already (e.g. a bookmark of this page) has nothing to do here.
        if (Auth.IsSignedIn)
        {
            Navigation.NavigateTo(SafeTarget(), replace: true);
        }
    }

    private async Task SubmitAsync()
    {
        _form.Reset();
        _form.Required("signin-user", _userName, L["FieldUserName"]);
        _form.Required("signin-password", _password, L["FieldPassword"]);
        if (await _form.ReportAsync(_error))
        {
            return;
        }

        _busy = true;
        var result = await Api.LoginAsync(new(_userName.Trim(), _password));
        _busy = false;
        if (!result.IsSuccess)
        {
            // A wrong password or a lock: the password is typed again, the name usually stays.
            _password = string.Empty;
            _form.Set("signin-password", result.Error!);
            await _form.ReportAsync(_error);
            return;
        }

        Logger.SignedIn();
        _password = string.Empty;
        await Auth.RefreshAsync();

        // The notice about an administrator's reset is on the start page; it comes before the target.
        Navigation.NavigateTo(Auth.AdminResets.Count == 0 ? SafeTarget() : SignInTarget.Fallback);
    }

    private string SafeTarget() => SignInTarget.Safe(Target, Navigation.BaseUri);
}
