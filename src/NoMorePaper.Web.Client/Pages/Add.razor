@page "/hinzufuegen"
@inject IStringLocalizer<Strings> L

@* Main item "Add": the two ways to bring a document in from this device (prompts.md §2). *@
<PageTitle>@L["AddTitle"]</PageTitle>

<MudText Typo="Typo.h2" HtmlTag="h1">@L["AddTitle"]</MudText>
<MudText Typo="Typo.body1" Class="add-intro">@L["AddIntro"]</MudText>

<ul class="link-tiles link-tiles-large">
    <li class="link-tile">
        <span class="link-tile-icon"><MudIcon Icon="@Icons.Material.Outlined.UploadFile" aria-hidden="true" /></span>
        <MudText Typo="Typo.h3" HtmlTag="h2">
            <a class="link-tile-title" href="hochladen" aria-describedby="add-upload-text">
                <span>@L["NavUpload"]</span>
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" aria-hidden="true" />
            </a>
        </MudText>
        <p id="add-upload-text">@L["AddUploadText"]</p>
    </li>
    <li class="link-tile">
        <span class="link-tile-icon"><MudIcon Icon="@Icons.Material.Outlined.PhotoCamera" aria-hidden="true" /></span>
        <MudText Typo="Typo.h3" HtmlTag="h2">
            <a class="link-tile-title" href="kamera" aria-describedby="add-camera-text">
                <span>@L["NavCamera"]</span>
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" aria-hidden="true" />
            </a>
        </MudText>
        <p id="add-camera-text">@L["AddCameraText"]</p>
    </li>
</ul>
