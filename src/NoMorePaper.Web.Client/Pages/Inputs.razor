@page "/eingaenge"
@using NoMorePaper.Web.Client.Inputs

<PageTitle>@L["InpTitle"]</PageTitle>

<Breadcrumb Items="_path" />

<div class="inputs-header">
    <div>
        <MudText Typo="Typo.h2" HtmlTag="h1" id="inputs-heading" tabindex="-1">@L["InpHeading"]</MudText>
        <p class="inputs-intro">@L["InpIntro"]</p>
    </div>
    <div class="inputs-refresh">
        <button type="button" id="inputs-refresh" class="nmp-button" @onclick="RefreshByHandAsync">
            <MudIcon Icon="@Icons.Material.Filled.Refresh" aria-hidden="true" />
            <span>@L["InpRefresh"]</span>
        </button>
        @if (_rows is not null)
        {
            <p data-ready>@L["InpUpdated", _now.ToLocalTime().ToString("T", System.Globalization.CultureInfo.CurrentCulture)]</p>
        }
    </div>
</div>
<LiveRegion @ref="_status" />

@if (_loadError is not null)
{
    <div data-ready><NoticeBox Kind="NoticeKind.Error" Announce="true" Message="@L["InpLoadError", _loadError]" /></div>
    <button type="button" id="inputs-retry" class="nmp-button" @onclick="RefreshByHandAsync">@L["Retry"]</button>
}
else if (_rows is null)
{
    <p role="status">@L["InpLoading"]</p>
}
else
{
    <TabList Items="_tabs" @bind-SelectedId="_selected" AriaLabel="@L["InpHeading"]" />

    <InputsPanel Kind="scanner-folder" Selected='IsSelected("scanner-folder")' Rows='RowsOf("scanner-folder")' Now="_now"
                 EmptyText="@L["InpStateNever"]">
        <About>
            <p>@L["InpScannerText"]</p>
            <p>@L["InpIntervalScanner"]</p>
        </About>
    </InputsPanel>

    <InputsPanel Kind="mail" Selected='IsSelected("mail")' Rows='RowsOf("mail")' Now="_now" EmptyText="@L["InpStateNever"]">
        <Below>
            @if (Auth.IsAdmin)
            {
                <p><a class="nmp-button" href="eingaenge/mail">@L[MailNotConfigured ? "InpMailSetUp" : "InpMailSettings"]</a></p>
            }
            else
            {
                <p>@L["InpMailAdminOnly"]</p>
            }
            <MailRules HeadingLevel="3" />
        </Below>
        <About>
            <p>@L["InpMailText"]</p>
            <p>@L["InpIntervalMail"]</p>
        </About>
    </InputsPanel>

    <InputsPanel Kind="icloud" Selected='IsSelected("icloud")' Rows='RowsOf("icloud")' Now="_now" EmptyText="@L["InpICloudNone"]">
        <About>
            <p>@L["InpICloudText"]</p>
            <p>@L["InpIntervalICloud"]</p>
            <p id="inputs-icloud-action">
                @if (!ICloudPageExists)
                {
                    @L["InpICloudPending"]
                }
                else if (MyCodeNeeded)
                {
                    <a href="eingaenge/icloud">@L["InpICloudRenewCode"]</a>
                }
                else
                {
                    <a href="eingaenge/icloud">@L[HasRows("icloud") ? "InpICloudSettings" : "InpICloudSetUp"]</a>
                }
            </p>
        </About>
    </InputsPanel>
}
