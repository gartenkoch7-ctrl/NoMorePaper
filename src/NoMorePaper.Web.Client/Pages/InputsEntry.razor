@using NoMorePaper.Contracts.Inputs
@using NoMorePaper.Web.Client.Inputs
@inject IStringLocalizer<Strings> L

@* One input, or one account's part of it, as a card on the page "Inputs". The state is a badge with symbol and
   word plus a sentence: never colour alone. A problem that needs somebody to act says so in words. *@
<div class="input-card">
    <div class="input-card-head">
        <span class="input-card-icon"><MudIcon Icon="@InputTabs.KindIcon(Row.Kind)" aria-hidden="true" /></span>
        <MudText Typo="Typo.h4" HtmlTag="h3">@Title</MudText>
    </div>
    <InputStateFacts Row="Row" Now="Now" />
    @if (ChildContent is not null)
    {
        <div class="input-card-actions">@ChildContent</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public InputStatusDto Row { get; set; } = default!;

    [Parameter] public DateTimeOffset Now { get; set; }

    /// <summary>Actions below the facts, for example the link to the settings.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string Title => Row.AccountName
        ?? (Row.Kind == "mail" ? L["InpCardMail"].Value : L["InpCardScanner"].Value);
}
