@page "/zu-pruefen"
@using System.Globalization

<PageTitle>@L["ReviewTitle"]</PageTitle>

<MudText Typo="Typo.h2" HtmlTag="h1" id="review-heading" tabindex="-1">@L["ReviewHeading"]</MudText>

<LiveRegion @ref="_status" />
<LiveRegion @ref="_error" Assertive="true" Class="form-error" />

@if (_loading)
{
    <p role="status">@L["ReviewLoading"]</p>
}
else if (_loadError is not null)
{
    <div data-ready><NoticeBox Kind="NoticeKind.Error" Announce="true" Message="@L["ReviewLoadError", _loadError]" /></div>
    <button type="button" id="review-retry" class="nmp-button" @onclick="LoadAsync">@L["Retry"]</button>
}
else if (_items.Length == 0)
{
    <p data-ready>@L["ReviewEmpty"]</p>
}
else
{
    <p class="review-summary" data-ready>@CountText(_items.Length)</p>
    <ul class="review-list" aria-label="@L["ReviewListLabel"]">
        @foreach (var item in _items)
        {
            var key = item.Id.ToString("N");
            <li @key="item.Id">
                <article class="review-item" aria-labelledby="review-h-@key">
                    <MudText Typo="Typo.h2" id="@("review-h-" + key)" tabindex="-1">
                        <a href="@DocumentLinks.Viewer(item.Id)">@item.Title</a>
                    </MudText>
                    <p class="fields-summary">
                        <span class="fields-term">@L["ClsFieldSummary"]:</span>
                        @(string.IsNullOrWhiteSpace(item.Fields.Summary) ? L["ClsNoSummary"] : item.Fields.Summary)
                    </p>
                    <p class="fields-recognition">
                        <Badge Icon="@(item.Fields.Recognition == DocumentRecognitionState.Confirmed ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.AutoAwesome)"
                               Text="@L["ClsRecognition" + item.Fields.Recognition]" />
                    </p>
                    <dl class="fields-list review-fields">
                        <div class="review-field"><dt>@L["ClsFieldCorrespondent"]</dt>
                        <dd>@(item.Fields.Correspondent?.Name ?? L["ClsNoValue"])</dd></div>
                        <div class="review-field"><dt>@L["ClsFieldType"]</dt>
                        <dd>@(item.Fields.DocumentType?.Name ?? L["ClsNoValue"])</dd></div>
                        <div class="review-field review-field-mono"><dt>@L["ClsFieldDate"]</dt>
                        <dd>@(item.Fields.DocumentDate is { } date ? FieldFormat.Date(date, CultureInfo.CurrentCulture) : L["ClsNoValue"])</dd></div>
                        <div class="review-field review-field-mono"><dt>@L["ClsFieldAmount"]</dt>
                        <dd>@(item.Fields.Amount is { } amount ? FieldFormat.Amount(amount, CultureInfo.CurrentCulture) : L["ClsNoValue"])</dd></div>
                        <div class="review-field"><dt>@L["ClsFieldTags"]</dt>
                        <dd>
                            @if (item.Fields.Tags.Count == 0)
                            {
                                @L["ClsNoValue"]
                            }
                            else
                            {
                                <ul class="review-tags">
                                    @foreach (var tag in item.Fields.Tags)
                                    {
                                        <li><Badge Text="@tag.Name" /></li>
                                    }
                                </ul>
                            }
                        </dd></div>
                    </dl>

                    <OwnerCheckSection DocumentId="item.Id" Title="@item.Title" Prefix="@("review-owner-" + key)" NeedsCheck="item.Fields.NeedsOwnerCheck" Household="_household" OnAnswered="answer => OwnerAnsweredAsync(item, answer)" />

                    @if (item.PossibleDuplicate is { } other)
                    {
                        <ReviewDuplicateSection Item="item" Other="other" OnKeep="() => KeepAsync(item)" OnAskDelete="() => AskDelete(item)" />
                    }

                    @if (_deleting?.Id == item.Id)
                    {
                        <ConfirmBox Id="@("review-confirm-" + key)" HeadingLevel="3" Title="@L["ReviewDeleteQuestion", item.Title]" Text="@L["ReviewDeleteExplain"]"
                                    ConfirmLabel="@L["ReviewDeleteConfirm"]" OnConfirm="DeleteAsync" OnCancel="CancelDelete" />
                    }

                    @if (_editing == item.Id)
                    {
                        <DocumentFieldsEditor DocumentId="item.Id" DocumentTitle="@item.Title" Fields="item.Fields"
                                              Prefix="@("review-" + key)" OnSaved="newTitle => SavedAsync(item, newTitle)"
                                              OnCancel="() => CancelEdit(item)" OnConflict="() => ChangedMeanwhileAsync(item)" />
                    }
                    else
                    {
                        <div class="button-row">
                            @if (item.Fields.Recognition == DocumentRecognitionState.Automatic)
                            {
                                <button type="button" class="nmp-button nmp-button-primary" aria-label="@L["ReviewConfirmFor", item.Title]"
                                        @onclick="() => ConfirmAsync(item)">
                                    <MudIcon Icon="@Icons.Material.Filled.Check" aria-hidden="true" />
                                    <span>@L["ClsConfirm"]</span>
                                </button>
                            }

                            <button type="button" id="review-edit-@key" class="nmp-button" aria-label="@L["ReviewEditFor", item.Title]"
                                    @onclick="() => StartEdit(item)">
                                <MudIcon Icon="@Icons.Material.Filled.Edit" aria-hidden="true" />
                                <span>@L["ClsEdit"]</span>
                            </button>
                        </div>
                    }
                </article>
            </li>
        }
    </ul>
}
