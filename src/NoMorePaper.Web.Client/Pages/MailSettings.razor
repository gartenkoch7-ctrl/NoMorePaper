@page "/eingaenge/mail"
@using NoMorePaper.Web.Client.Inputs
@inject IStringLocalizer<Strings> L
@inject AuthState Auth
@inject HttpClient Http
@inject ILoggerFactory Loggers
@inject IJSRuntime Js
@inject InputsApi StatusApi
@inject TimeProvider Clock

@* The household's mailbox, for the administrator. The password is never shown or sent back: the page only
   says whether one is stored, and an empty field keeps it. Every result is said in words in a live region. *@
<PageTitle>@L["MailTitle"]</PageTitle>

<Breadcrumb Items="_path" />

<MudText Typo="Typo.h2" HtmlTag="h1">@L["MailHeading"]</MudText>

@if (!Auth.IsAdmin)
{
    <p data-ready>@L["MailAdminOnly"]</p>
}
else if (_loadError is not null)
{
    <div role="alert" class="error-box" data-ready>
        <MudIcon Icon="@Icons.Material.Filled.Error" />
        <span>@L["ErrorPrefix", _loadError]</span>
    </div>
    <button type="button" class="nmp-button" @onclick="LoadAsync">@L["Retry"]</button>
}
else if (_loading)
{
    <p role="status">@L["MailLoading"]</p>
}
else
{
    <p data-ready>@L["MailExplain"]</p>
    <div class="mail-layout">
    <div class="mail-layout-card"><MailboxCard Host="@_storedSignIn.Host" Port="@(int.TryParse(_storedSignIn.Port, out var storedPort) ? storedPort : 0)"
                 Security="@_storedSignIn.Security" UserName="@_storedSignIn.User" Row="_mailRow" StateFailed="_stateFailed"
                 Now="_now" /></div>
    <section class="mail-layout-form" aria-labelledby="mail-form-heading">
    <MudText Typo="Typo.h4" HtmlTag="h2" id="mail-form-heading">@L["MailFormHeading"]</MudText>
    <form class="account-form" novalidate @onsubmit="SaveAsync">
        <FormField Id="mail-host" Label="@L["MailFieldHost"]" Hint="@L["MailHintHost"]" @bind-Value="_host"
                   Invalid='_form.IsInvalid("mail-host")' />
        <div class="form-field">
            <label for="mail-port">@L["MailFieldPort"]</label>
            <p id="mail-port-hint" class="form-hint">@L["MailHintPort"]</p>
            <input id="mail-port" class="form-input" type="number" inputmode="numeric" min="1" max="65535" value="@_port"
                   @oninput="e => _port = e.Value?.ToString() ?? string.Empty" aria-required="true"
                   aria-invalid='@(_form.IsInvalid("mail-port") ? "true" : null)' aria-describedby="mail-port-hint" />
        </div>
        <div class="form-field">
            <label for="mail-security">@L["MailFieldSecurity"]</label>
            <select id="mail-security" class="form-input" value="@_security" aria-invalid='@(_form.IsInvalid("mail-security") ? "true" : null)' @onchange="e => _security = e.Value?.ToString() ?? Ssl">
                <option value="ssl">@L["MailSecuritySsl"]</option>
                <option value="starttls">@L["MailSecurityStartTls"]</option>
            </select>
        </div>
        <FormField Id="mail-user" Label="@L["MailFieldUser"]" Autocomplete="username" @bind-Value="_user"
                   Invalid='_form.IsInvalid("mail-user")' />
        <div class="form-field">
            <label for="mail-password">@L["MailFieldPassword"]</label>
            <p id="mail-password-hint" class="form-hint">@(!_hasPassword ? L["MailHintPasswordNone"] : PasswordNeeded ? L["MailHintPasswordAgain"] : L["MailHintPasswordStored"])</p>
            <div class="form-field-row">
                <input id="mail-password" class="form-input" type="@(_showPassword ? "text" : "password")" value="@_password"
                       @oninput="e => _password = e.Value?.ToString() ?? string.Empty" autocomplete="new-password"
                       autocapitalize="off" autocorrect="off" spellcheck="false" aria-required="@(PasswordNeeded ? "true" : "false")"
                       aria-invalid='@(_form.IsInvalid("mail-password") ? "true" : null)' aria-describedby="mail-password-hint" />
                <button type="button" class="form-toggle" aria-pressed="@(_showPassword ? "true" : "false")"
                        aria-label="@L["ShowPasswordFor", L["MailFieldPassword"]]" @onclick="() => _showPassword = !_showPassword">@L["ShowPassword"]</button>
            </div>
        </div>
        <div class="form-field">
            <label for="mail-authserv">@L["MailFieldAuthServId"]</label>
            <p id="mail-authserv-hint" class="form-hint">@L["MailHintAuthServId"]</p>
            <input id="mail-authserv" class="form-input" type="text" value="@_authServId" autocomplete="off" autocapitalize="off"
                   spellcheck="false" @oninput="e => _authServId = e.Value?.ToString() ?? string.Empty" aria-required="false"
                   aria-describedby="mail-authserv-hint" />
        </div>
        <LiveRegion @ref="_error" Assertive="true" Class="form-error" />
        <LiveRegion @ref="_status" />
        <div class="button-row">
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">@L["MailSave"]</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="TestAsync">@L["MailTest"]</MudButton>
        </div>
    </form>
    </section>
    <div class="mail-layout-rules"><MailRules HeadingLevel="2" /></div>
    </div>
}
