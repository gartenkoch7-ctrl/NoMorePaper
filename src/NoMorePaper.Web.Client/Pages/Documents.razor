@page "/dokumente"
@implements IDisposable

<PageTitle>@L["DocumentsTitle"]</PageTitle>

@* Stitch screen 02. A native h1 because the theme's h1 (40 px) is larger than the design's headline-lg. *@
<div class="doc-page-head">
    <div>
        <h1 class="doc-page-title">@L["DocumentsHeading"]</h1>
        @if (_counts is not null)
        {
            <span class="doc-count">@(_counts.Total == 1 ? L["DocListCountOne"].Value : L["DocListCount", _counts.Total].Value)</span>
        }
    </div>
    <div class="view-toggle" role="group" aria-label="@L["DocListViewGroup"]">
        <button type="button" aria-pressed="@(_view == DocumentListView.Table ? "true" : "false")" @onclick="() => SetView(DocumentListView.Table)">
            <MudIcon Icon="@Icons.Material.Outlined.ViewList" aria-hidden="true" />
            <span>@L["DocListViewTable"]</span>
        </button>
        <button type="button" aria-pressed="@(_view == DocumentListView.Tiles ? "true" : "false")" @onclick="() => SetView(DocumentListView.Tiles)">
            <MudIcon Icon="@Icons.Material.Outlined.GridView" aria-hidden="true" />
            <span>@L["DocListViewTiles"]</span>
        </button>
    </div>
</div>

<div class="doc-filter-card">
    <DocumentFilterBar ActiveCount="@DocumentFilterQuery.ActiveCount(_barFilter)" OnApply="ApplyFilterAsync" />
    @if (_counts is not null || _typeId is not null)
    {
        <DocumentTypeChips Counts="_counts" SelectedTypeId="_typeId" OnSelect="SelectTypeAsync" />
    }
</div>

@* Two regions: the state changes of the poll and the number of documents a filter found must not cut each other off. *@
<LiveRegion @ref="_changes" Class="documents-changes" />
<LiveRegion @ref="_count" Class="documents-count" />

@if (_loading)
{
    <p role="status">@L["DocumentsLoading"]</p>
}
else if (_error is not null)
{
    <div role="alert" class="error-box" data-ready>
        <MudIcon Icon="@Icons.Material.Filled.Error" />
        <span>@L["DocumentsLoadError", _error]</span>
    </div>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ReloadAsync">@L["Retry"]</MudButton>
}
else if (_documents.Length == 0 && _page == 1)
{
    <p data-ready>@(DocumentFilterQuery.ActiveCount(Combined) > 0 ? L["DocumentsEmptyFiltered"] : L["DocumentsEmpty"])</p>
}
else
{
    <div class="doc-list-frame" data-ready>
        @if (_view == DocumentListView.Table)
        {
            <DocumentTable Documents="_documents" />
        }
        else
        {
            <DocumentTiles Documents="_documents" />
        }
        <DocumentPager Page="_page" PageSize="_pageSize" Total="_counts?.Total" Shown="_documents.Length" PageSizes="PageSizes"
                       PageChanged="ChangePageAsync" PageSizeChanged="ChangePageSizeAsync" />
    </div>
}
