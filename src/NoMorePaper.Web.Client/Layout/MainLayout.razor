@inherits LayoutComponentBase
@implements IDisposable
@inject IStringLocalizer<Strings> L
@inject NavigationManager Navigation
@inject AuthState Auth
@inject ReviewCounter Review

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />

@* First focusable element on every page (WCAG 2.4.1). Focus is moved by code because Blazor
   would otherwise treat the fragment link as a navigation. *@
<a class="skip-link" href="#main-content" @onclick="SkipToContentAsync" @onclick:preventDefault>
    @L["SkipToContent"]
</a>

<header class="app-header">
    <span class="app-name">NoMorePaper</span>
    @* Navigation, search and account only exist for a signed-in person. *@
    @if (Auth.IsSignedIn)
    {
        <nav class="app-nav" aria-label="@L["MainNavigation"]">
            <ul>
                <li><a href="" aria-current="@(IsCurrent("") ? "page" : null)">@L["NavHome"]</a></li>
                <li><a href="hochladen" aria-current="@(IsCurrent("hochladen") ? "page" : null)">@L["NavUpload"]</a></li>
                <li><a href="dokumente" aria-current="@(IsCurrent("dokumente") ? "page" : null)">@L["NavDocuments"]</a></li>
                <li><a href="zu-pruefen" aria-current="@(IsCurrent("zu-pruefen") ? "page" : null)">@(Review.Count is > 0 and var waiting ? L["NavReviewCount", waiting] : L["NavReview"])</a></li>
                <li><a href="suche" aria-current="@(IsCurrent("suche") ? "page" : null)">@L["NavSearch"]</a></li>
                <li><a href="listen" aria-current="@(IsCurrent("listen") ? "page" : null)">@L["NavLists"]</a></li>
                <li><a href="eingaenge" aria-current="@(IsCurrent("eingaenge") ? "page" : null)">@L["NavInputs"]</a></li>
                <li><a href="konto" aria-current="@(IsCurrent("konto") ? "page" : null)">@L["NavAccount"]</a></li>
                @if (Auth.IsAdmin)
                {
                    <li><a href="mitglieder" aria-current="@(IsCurrent("mitglieder") ? "page" : null)">@L["NavMembers"]</a></li>
                }
            </ul>
        </nav>
        <HeaderSearch />
        <AccountMenu />
    }

    <LanguageSwitch />
</header>

<main id="main-content" class="app-main" tabindex="-1" @ref="_main">
    <RequireSignIn>
        @Body
    </RequireSignIn>
</main>

@code {
    private readonly MudTheme _theme = ContrastTheme.Create();
    private ElementReference _main;

    protected override void OnInitialized()
    {
        Auth.Changed += OnAuthChanged;
        Navigation.LocationChanged += OnLocationChanged;
        Review.Changed += OnReviewChanged;
    }

    private void OnAuthChanged()
    {
        _ = InvokeAsync(StateHasChanged);
        RefreshReviewCount();
    }

    private void OnReviewChanged() => _ = InvokeAsync(StateHasChanged);

    // The current page is marked in the navigation, so the layout renders again on navigation.
    // The number of documents to review is asked again then too: uploads and the recognition
    // add to it while the person is elsewhere.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
        RefreshReviewCount();
    }

    private void RefreshReviewCount()
    {
        if (Auth.IsSignedIn)
        {
            _ = Review.RefreshAsync();
        }
        else
        {
            Review.Set(null);
        }
    }

    private bool IsCurrent(string path) =>
        Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0] == path;

    private async Task SkipToContentAsync() => await _main.FocusAsync();

    public void Dispose()
    {
        Auth.Changed -= OnAuthChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        Review.Changed -= OnReviewChanged;
    }
}
