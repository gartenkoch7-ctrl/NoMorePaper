@inherits LayoutComponentBase
@implements IDisposable
@inject IStringLocalizer<Strings> L
@inject NavigationManager Navigation
@inject AuthState Auth
@inject ReviewCounter Review

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />

@* First focusable element on every page (WCAG 2.4.1). Focus is moved by code because Blazor
   would otherwise treat the fragment link as a navigation. *@
<a class="skip-link" href="#main-content" @onclick="SkipToContentAsync" @onclick:preventDefault>
    @L["SkipToContent"]
</a>

<div class="app-shell @(Auth.IsSignedIn ? null : "app-shell-signed-out")">
<header class="app-header">
    @if (Auth.IsSignedIn)
    {
        @* Text on the button, not only a symbol (prompts.md §2). Hidden on wide screens by CSS. *@
        <button type="button" class="nmp-button menu-toggle" aria-expanded="@(_menuOpen ? "true" : "false")"
                aria-controls="side-nav" @onclick="ToggleMenu" @ref="_menuButton">
            <MudIcon Icon="@(_menuOpen ? Icons.Material.Filled.Close : Icons.Material.Filled.Menu)" aria-hidden="true" />
            <span>@L["Menu"]</span>
        </button>
        <HeaderSearch />
        <div class="header-end">
            <a href="hochladen" class="nmp-button nmp-button-primary header-upload">
                <MudIcon Icon="@Icons.Material.Filled.Add" aria-hidden="true" />
                <span>@L["NavUpload"]</span>
            </a>
            <AccountMenu />
            <LanguageSwitch />
        </div>
    }
    else
    {
        <span class="app-name">NoMorePaper</span>
        <div class="header-end">
            <LanguageSwitch />
        </div>
    }
</header>

@if (Auth.IsSignedIn)
{
    <SideNav @ref="_sideNav" Id="side-nav" Current="@NavSection.For(Navigation.ToBaseRelativePath(Navigation.Uri))"
             Open="_menuOpen" Escaped="CloseMenuAndReturnFocusAsync" />
}

<main id="main-content" class="app-main" tabindex="-1" @ref="_main">
    <RequireSignIn>
        @Body
    </RequireSignIn>
</main>
</div>

@code {
    private readonly MudTheme _theme = ContrastTheme.Create();
    private ElementReference _main;
    private ElementReference _menuButton;
    private SideNav? _sideNav;
    private bool _menuOpen;
    private bool _focusMenu;

    protected override void OnInitialized()
    {
        Auth.Changed += OnAuthChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnAuthChanged()
    {
        _ = InvokeAsync(StateHasChanged);
        RefreshReviewCount();
    }

    // The current page is marked in the navigation, so the layout renders again on navigation;
    // any navigation (side navigation, header, tiles, back key) closes the menu on a phone.
    // The number of documents to review is asked again then too: uploads and the recognition
    // add to it while the person is elsewhere.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _menuOpen = false;
        _ = InvokeAsync(StateHasChanged);
        RefreshReviewCount();
    }

    private void RefreshReviewCount()
    {
        if (Auth.IsSignedIn)
        {
            _ = Review.RefreshAsync();
        }
        else
        {
            Review.Set(null);
        }
    }

    // Opening moves focus to the first link: otherwise the header (search, upload, account,
    // language) would come between the button and the navigation it opened.
    private void ToggleMenu()
    {
        _menuOpen = !_menuOpen;
        _focusMenu = _menuOpen;
    }

    private async Task CloseMenuAndReturnFocusAsync()
    {
        _menuOpen = false;
        StateHasChanged();
        await _menuButton.FocusAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusMenu && _sideNav is not null)
        {
            _focusMenu = false;
            await _sideNav.FocusFirstAsync();
        }
    }

    private async Task SkipToContentAsync() => await _main.FocusAsync();

    public void Dispose()
    {
        Auth.Changed -= OnAuthChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
