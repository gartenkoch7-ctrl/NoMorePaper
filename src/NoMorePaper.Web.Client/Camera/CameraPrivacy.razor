@using NoMorePaper.Web.Client.Inputs
@inject IStringLocalizer<Strings> L
@inject PreferencesApi Preferences
@inject IJSRuntime Js

@* The "private" switch of the camera page, preset from the account. It sends a choice only when the person
   changed it; otherwise the server applies the account's setting. Should that setting not load, the switch
   never claims "shared": it is in its third state ("mixed") and the hint says the account decides. *@
<div class="form-check">
    <input id="cam-private" type="checkbox" checked="@(Effective ?? false)" aria-describedby="cam-private-hint"
           @onchange="args => _choice = args.Value is true" />
    <label for="cam-private">@L["PrivateLabel"]</label>
</div>
<p id="cam-private-hint" class="form-hint">@(IsUnknown ? L["CamPrivateUnknown"] : L["CamPrivateHint"])</p>

@code {
    // The account's setting; null until it is loaded, and when it could not be.
    private bool? _preference;
    private bool? _choice;
    private bool _loaded;
    private bool _indeterminate;

    /// <summary>What "Fertig" sends: the person's own choice, or <c>null</c> so the server takes the account's setting.</summary>
    public bool? Choice => _choice;

    /// <summary>What the document becomes: the choice, else the account's setting; <c>null</c> when neither is known.</summary>
    public bool? Effective => _choice ?? _preference;

    private bool IsUnknown => _loaded && Effective is null;

    protected override async Task OnInitializedAsync()
    {
        var result = await Preferences.GetAsync();
        (_preference, _loaded) = (result.Value?.NewDocumentsPrivate, true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_indeterminate != IsUnknown)
        {
            _indeterminate = IsUnknown;
            await Js.InvokeVoidAsync("nmpForms.setIndeterminate", "cam-private", _indeterminate);
        }
    }
}
